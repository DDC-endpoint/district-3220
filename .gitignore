# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env
.env
.env*.local

# typescript
*.tsbuildinfo

# editor
.vscode/*
!.vscode/extensions.json
.idea

# agent tooling — installed per-machine (npx skills add), not project source.
# .claude/skills holds junctions into .agents, so both are excluded.
/.agents/
/.claude/skills/

# specclaw eval journal: a per-machine log a local hook writes on every
# subagent run; not project source.
.specclaw/**/eval-journal.md

# cloudflare (OpenNext build output, local wrangler state, local secrets)
/.open-next/
/.wrangler/
.dev.vars*
!.dev.vars.example
# build-time variables for `npm run cf-build` (the calendar address); read
# only into the build's environment, never bundled. See .env.example.
.env.build
