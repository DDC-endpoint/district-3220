// Cloudflare Workers config for the site, run through the OpenNext adapter
// (`@opennextjs/cloudflare`). Setup and the reasons for each binding:
// HANDOFF.md, "To switch on at launch".
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "district-3220",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "upload_source_maps": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },

  // The site answers only on its own domain (attached 2026-11-15). www is
  // canonical (SITE.url); the bare domain is redirected to www by a Redirect
  // Rule on the zone, before the Worker runs. The workers.dev and preview
  // addresses are off so no duplicate copy of the site is public.
  "routes": [
    { "pattern": "www.interactdistrict3220.org", "custom_domain": true },
    { "pattern": "interactdistrict3220.org", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,

  // The worker calls itself to revalidate ISR pages (the calendar, hourly).
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "district-3220"
    }
  ],

  // Incremental cache: prerendered pages and the calendar's fetch cache.
  // Workers KV (namespace `district-3220-next-cache`), chosen 2026-11-15
  // over R2 because R2 needs a payment method on the account. KV takes up
  // to ~60 s to spread a write worldwide, which is fine for a calendar that
  // refreshes hourly. To move to R2 later: an `r2_buckets` binding named
  // NEXT_INC_CACHE_R2_BUCKET and the R2 cache in open-next.config.ts.
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "ca8dc820400b43c18ea3b9f34ce26031"
    }
  ],

  // Queue that de-duplicates time-based revalidations.
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],

  // next/image resizing and AVIF/WebP, through Cloudflare Images.
  "images": {
    "binding": "IMAGES"
  }

  // DISTRICT_CALENDAR_ICS_URL is a secret, set on the Worker (dashboard or
  // `wrangler secret put`), never here.
}
